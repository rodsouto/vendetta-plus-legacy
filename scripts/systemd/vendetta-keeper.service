# Deployment template only. It does not approve keys, consumers or a real-network release.
# Review paths, secrets, resource limits and rollout evidence before installation.
[Unit]
Description=Vendetta certificate keeper
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=vendetta-keeper
Group=vendetta-keeper
WorkingDirectory=/opt/vendetta/apps/web
EnvironmentFile=/etc/vendetta/keeper.env
Environment=KEEPER_STATE_DIR=/var/lib/vendetta-keeper
ExecStart=/usr/bin/node --import /opt/vendetta/apps/web/node_modules/tsx/dist/loader.mjs /opt/vendetta/apps/web/scripts/keeper.ts /etc/vendetta/deployment.json
StateDirectory=vendetta-keeper
StateDirectoryMode=0700
UMask=0077
KillMode=mixed
SendSIGKILL=yes
TimeoutStopSec=150
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
