pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";

/// Smoke test: the spec data generated by `pnpm codegen` is readable from Foundry.
contract SpecDataTest is Test {
    string internal constant GENERATED = "../packages/spec-data/generated/";

    function test_readsLegacyCombatVector() public view {
        string memory json = vm.readFile(string.concat(GENERATED, "test_vectors.json"));
        assertEq(vm.parseJsonString(json, ".combat.cases[0].label"), "small vs small");
        assertEq(vm.parseJsonUint(json, ".combat.cases[0].expected.rounds_count"), 4);
    }

    function test_readsRuleset() public view {
        string memory json = vm.readFile(string.concat(GENERATED, "vendetta.json"));
        assertEq(vm.parseJsonString(json, ".ruleset"), "vendetta");
        assertEq(vm.parseJsonUint(json, ".rules.troop_defense_multiplier"), 10);
    }
}
