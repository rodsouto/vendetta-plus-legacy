/// Differential test: replays the scenarios generated by the TypeScript simulator
/// (packages/rules/scripts/scenarios.ts) and requires the same reverts and the same stored state
/// after every step.
contract ScenariosTest is GameTestBase {
    string internal constant DIR = "../packages/rules/generated/scenarios/vendetta/";

    string internal constant TYPES = "Scenario(uint256 actors,uint256 seed,Step[] steps)"
        "BuildingSnap(uint256 centipoints,uint256 id,uint256 last_return,uint256 last_update,uint256[] levels,uint256 owner,uint256[] queue_finish,uint256[] queue_index,uint256[] queue_seq,uint256[] stock,uint256[] training_attack,uint256[] training_defense,uint256[] troops)"
        "InviteSnap(uint256 actor,uint256 epoch,uint256 kind,uint256 player,uint256 recovery,uint256 until)"
        "MissionSnap(uint256[] cargo,uint256[] fields,uint256 id,uint256[] troops)"
        "FamilySnap(bool alive,uint256 id,uint256 members,string name,string tag)"
        "PlayerSnap(uint256[] applications,uint256 buildings,uint256 centipoints,uint256[] controllers,uint256 id,uint256 missions,uint256[] offers,uint256[] owes,uint256[] queue_finish,uint256[] queue_index,uint256[] queue_seq,uint256[] recovery,uint256[] removal_at,uint256[] research,uint256 research_building,uint256[] social)"
        "SessionSnap(uint256 actor,uint256 epoch,uint256 player,uint256 until)"
        "State(BuildingSnap[] buildings,FamilySnap[] families,InviteSnap[] invites,MissionSnap[] missions,uint256[] parked,PlayerSnap[] players,SessionSnap[] sessions,TradeSnap[] trades,WarSnap[] wars)"
        "TradeSnap(uint256[] fields,uint256 id,uint256[] paid,uint256[] price,uint256[] returned)"
        "WarSnap(uint256[] fields,uint256 id)"
        "Step(uint256 action,uint256 actor,uint256[] args,string error,State state,uint256 time)";

    struct BuildingSnap {
        uint256 centipoints;
        uint256 id;
        uint256 lastReturn;
        uint256 lastUpdate;
        uint256[] levels;
        uint256 owner;
        uint256[] queueFinish;
        uint256[] queueIndex;
        uint256[] queueSeq;
        uint256[] stock;
        uint256[] trainingAttack; // (troop, quantity, seq, finishAt) per batch
        uint256[] trainingDefense;
        uint256[] troops;
    }

    struct MissionSnap {
        uint256[] cargo;
        // owner, origin, kind, returning, city, neighborhood, slot, start, arrival, duration, seq,
        // fromCity, fromNeighborhood, fromSlot, hidden, cover
        uint256[] fields;
        uint256 id;
        uint256[] troops;
    }

    struct FamilySnap {
        bool alive;
        uint256 id;
        uint256 members;
        string name;
        string tag;
    }

    struct TradeSnap {
        // seller, buyer, sold, accepted, acceptedAt, quantity, delivered, rate, registered
        uint256[] fields;
        uint256 id;
        uint256[] paid;
        uint256[] price;
        uint256[] returned;
    }

    struct WarSnap {
        uint256[] fields; // a, b, lostA, lostB, ended, winner, offer, offerBy
        uint256 id;
    }

    struct PlayerSnap {
        uint256[] applications;
        uint256 buildings;
        uint256 centipoints;
        uint256[] controllers; // actor ids, in the contract's order
        uint256 id;
        uint256 missions;
        uint256[] offers;
        uint256[] owes; // registered unpaid debts to every player, by id (B-11)
        uint256[] queueFinish;
        uint256[] queueIndex;
        uint256[] queueSeq;
        uint256[] recovery; // parallel to controllers: 1 = a recovery code (B-15)
        uint256[] removalAt; // parallel to controllers: when a scheduled removal is due, 0 = none
        uint256[] research;
        uint256 researchBuilding;
        // vacationUntil, suspendedUntil, premiumUntil, family, rank, sessionEpoch, vacationStart,
        // debts, tradeLockUntil, transferTo (actor id), transferAt, vacationSeq
        uint256[] social;
    }

    struct SessionSnap {
        uint256 actor; // every session ever authorized; zeros once gone
        uint256 epoch;
        uint256 player;
        uint256 until;
    }

    struct InviteSnap {
        uint256 actor; // every (address, player) pair ever invited; zeros once gone
        uint256 epoch;
        uint256 kind;
        uint256 player;
        uint256 recovery;
        uint256 until;
    }

    struct State {
        BuildingSnap[] buildings;
        FamilySnap[] families;
        InviteSnap[] invites;
        MissionSnap[] missions;
        uint256[] parked; // due hidden missions nobody revealed yet, in list order (B-22)
        PlayerSnap[] players;
        SessionSnap[] sessions;
        TradeSnap[] trades;
        WarSnap[] wars;
    }

    struct Step {
        uint256 action;
        uint256 actor;
        uint256[] args;
        string error;
        State state;
        uint256 time;
    }

    struct Scenario {
        uint256 actors;
        uint256 seed;
        Step[] steps;
    }

    // One test per group of scenarios: Foundry never frees memory within a test.
    // 0-15: random core scenarios; 16-23: bots (missions, battles, occupations); 24-27: bots with
