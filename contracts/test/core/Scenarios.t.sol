pragma solidity 0.8.28;

import {console} from "forge-std/Test.sol";
import {Game} from "../../src/Game.sol";
import {ROOMS, RESEARCH, RESOURCES, TROOPS} from "../../src/generated/VendettaRuleset.sol";
import {
    QueueItem,
    TrainingItem,
    Mission,
    Family,
    War,
    Trade,
    Session
} from "../../src/core/GameStorage.sol";
import {GameTestBase} from "./GameTestBase.sol";

/// Differential test: replays the scenarios generated by the TypeScript simulator
/// (packages/rules/scripts/scenarios.ts) and requires the same reverts and the same stored state
/// after every step.
contract ScenariosTest is GameTestBase {
    string internal constant DIR = "../packages/rules/generated/scenarios/vendetta/";
    string internal constant TYPES = "Scenario(uint256 actors,uint256 seed,Step[] steps)"
        "BuildingSnap(uint256 centipoints,uint256 id,uint256 last_update,uint256[] levels,uint256 owner,uint256[] queue_finish,uint256[] queue_index,uint256[] queue_seq,uint256[] stock,uint256[] training_attack,uint256[] training_defense,uint256[] troops)"
        "MissionSnap(uint256[] cargo,uint256[] fields,uint256 id,uint256[] troops)"
        "FamilySnap(bool alive,uint256 id,uint256 members,string name,string tag)"
        "PlayerSnap(uint256[] applications,uint256 buildings,uint256 centipoints,uint256[] controllers,uint256 id,uint256 missions,uint256[] offers,uint256[] queue_finish,uint256[] queue_index,uint256[] queue_seq,uint256[] research,uint256 research_building,uint256[] social)"
        "SessionSnap(uint256 actor,uint256 epoch,uint256 player,uint256 until)"
        "State(BuildingSnap[] buildings,FamilySnap[] families,MissionSnap[] missions,PlayerSnap[] players,SessionSnap[] sessions,TradeSnap[] trades,WarSnap[] wars)"
        "TradeSnap(uint256[] fields,uint256 id,uint256[] paid,uint256[] price)"
        "WarSnap(uint256[] fields,uint256 id)"
        "Step(uint256 action,uint256 actor,uint256[] args,string error,State state,uint256 time)";

    struct BuildingSnap {
        uint256 centipoints;
        uint256 id;
        uint256 lastUpdate;
        uint256[] levels;
        uint256 owner;
        uint256[] queueFinish;
        uint256[] queueIndex;
        uint256[] queueSeq;
        uint256[] stock;
        uint256[] trainingAttack; // (troop, quantity, seq, finishAt) per batch
        uint256[] trainingDefense;
        uint256[] troops;
    }

    struct MissionSnap {
        uint256[] cargo;
        // owner, origin, kind, returning, city, neighborhood, slot, start, arrival, duration, seq
        uint256[] fields;
        uint256 id;
        uint256[] troops;
    }

    struct FamilySnap {
        bool alive;
        uint256 id;
        uint256 members;
        string name;
        string tag;
    }

    struct TradeSnap {
        uint256[] fields; // seller, buyer, sold, accepted, acceptedAt, quantity, delivered
        uint256 id;
        uint256[] paid;
        uint256[] price;
    }

    struct WarSnap {
        uint256[] fields; // a, b, lostA, lostB, ended, winner, offer, offerBy
        uint256 id;
    }

    struct PlayerSnap {
        uint256[] applications;
        uint256 buildings;
        uint256 centipoints;
        uint256[] controllers; // actor ids, in the contract's order
        uint256 id;
        uint256 missions;
        uint256[] offers;
        uint256[] queueFinish;
        uint256[] queueIndex;
        uint256[] queueSeq;
        uint256[] research;
        uint256 researchBuilding;
        uint256[] social; // vacationUntil, suspendedUntil, premiumUntil, family, rank, sessionEpoch
    }

    struct SessionSnap {
        uint256 actor; // every session ever authorized; zeros once gone
        uint256 epoch;
        uint256 player;
        uint256 until;
    }

    struct State {
        BuildingSnap[] buildings;
        FamilySnap[] families;
        MissionSnap[] missions;
        PlayerSnap[] players;
        SessionSnap[] sessions;
        TradeSnap[] trades;
        WarSnap[] wars;
    }

    struct Step {
        uint256 action;
        uint256 actor;
        uint256[] args;
        string error;
        State state;
        uint256 time;
    }

    struct Scenario {
        uint256 actors;
        uint256 seed;
        Step[] steps;
    }

    // One test per group of scenarios: Foundry never frees memory within a test.
    // 0-15: random core scenarios; 16-23: bots (missions, battles, occupations).
    function test_random_00_03() public {
        _run(0, 4);
    }

    function test_random_04_07() public {
        _run(4, 8);
    }

    function test_random_08_11() public {
        _run(8, 12);
    }

    function test_random_12_15() public {
        _run(12, 16);
    }

    function test_bots_16() public {
        _run(16, 17);
    }

    function test_bots_17() public {
        _run(17, 18);
    }

    function test_bots_18() public {
        _run(18, 19);
    }

    function test_bots_19() public {
        _run(19, 20);
    }

    function test_bots_20() public {
        _run(20, 21);
    }

    function test_bots_21() public {
        _run(21, 22);
    }

    function test_bots_22() public {
        _run(22, 23);
    }

    function test_bots_23() public {
        _run(23, 24);
    }

    function test_allScenariosCovered() public view {
        assertEq(
            vm.parseJsonUint(vm.readFile(string.concat(DIR, "index.json")), ".count"),
            24,
            "update the test groups"
        );
    }

    function _run(uint256 from, uint256 to) internal {
        uint256 steps;
        for (uint256 i = from; i < to; ++i) {
            string memory name = string.concat(i < 10 ? "0" : "", vm.toString(i), ".json");
            Scenario memory sc = abi.decode(
                vm.parseJsonType(vm.readFile(string.concat(DIR, name)), TYPES), (Scenario)
            );
            steps += _replay(sc);
        }
        console.log("scenarios:", to - from, "steps:", steps);
    }

    function _replay(Scenario memory sc) internal returns (uint256) {
        Game game = deployGame();
        for (uint256 s; s < sc.steps.length; ++s) {
            Step memory st = sc.steps[s];
            vm.warp(st.time);
            string memory got = _act(game, st);
            if (keccak256(bytes(got)) != keccak256(bytes(st.error)) || !_matches(game, st.state)) {
                // Re-run the comparison with messages only on failure (messages cost memory).
                string memory where =
                    string.concat("seed ", vm.toString(sc.seed), " step ", vm.toString(s));
                assertEq(got, st.error, string.concat(where, ": revert"));
                _compare(game, st.state, where);
                assertTrue(_matches(game, st.state), string.concat(where, ": state"));
            }
        }
        return sc.steps.length;
    }

    function _act(Game game, Step memory st) internal returns (string memory) {
        bool byAdmin = st.action == 6 || st.action == 15 || st.action == 16;
        address who = byAdmin ? admin : address(uint160(0x1000 + st.actor));
        uint256[] memory a = st.args;
        bytes memory call;
        uint256 act = st.action;
        if (act == 0) call = abi.encodeCall(Game.register, (a[0], a[1], a[2]));
        else if (act == 1) call = abi.encodeCall(Game.queueRoom, (uint64(a[0]), a[1]));
        else if (act == 2) call = abi.encodeCall(Game.queueResearch, (uint64(a[0]), a[1]));
        else if (act == 3) call = abi.encodeCall(Game.cancelRoom, (uint64(a[0]), a[1]));
        else if (act == 4) call = abi.encodeCall(Game.cancelResearch, (uint64(a[0]), a[1]));
        else if (act == 5) call = abi.encodeCall(Game.poke, (uint64(a[0])));
        else if (act == 6) call = abi.encodeCall(Game.setGlobalPremium, (a[0]));
        else if (act == 7) call = abi.encodeCall(Game.train, (uint64(a[0]), a[1], a[2]));
        else if (act == 8) call = abi.encodeCall(Game.cancelTraining, (uint64(a[0]), a[1], a[2]));
        else if (act == 9) call = _sendCall(a);
        else if (act == 10) call = abi.encodeCall(Game.recall, (uint64(a[0])));
        else if (act == 11) call = abi.encodeCall(Game.abandon, (uint64(a[0])));
        else if (act == 12) call = abi.encodeCall(Game.advance, (a[0]));
        else call = _socialCall(act, a);
        vm.prank(who);
        (bool ok, bytes memory ret) = address(game).call(call);
        if (ok) return "";
        return _errorName(bytes4(ret));
    }

    /// Family tags and names by index, as in packages/rules/scripts/scenarios.ts.
    function _name(uint256 i) internal pure returns (string memory) {
        string[11] memory names = [
            "MOB",
            "mob",
            "Cosa Nostra",
            "Los Pibes",
            "AB",
            "A",
            "Camorra",
            unicode"Ñandú",
            "The Family",
            "THE FAMILY",
            "Yakuza"
        ];
        return names[i];
    }

    function _socialCall(uint256 act, uint256[] memory a) internal pure returns (bytes memory) {
        if (act == 13) return abi.encodeCall(Game.startVacation, ());
        if (act == 14) return abi.encodeCall(Game.endVacation, ());
        if (act == 15) return abi.encodeCall(Game.suspend, (uint64(a[0]), a[1]));
        if (act == 16) return abi.encodeCall(Game.grantPremium, (uint64(a[0]), a[1]));
        if (act == 17) {
            return abi.encodeCall(Game.transferPlayer, (address(uint160(0x1000 + a[0]))));
        }
        if (act == 33) {
            return abi.encodeCall(Game.authorizeSession, (address(uint160(0x1000 + a[0])), a[1]));
        }
        if (act == 34) {
            return abi.encodeCall(Game.revokeSession, (address(uint160(0x1000 + a[0]))));
        }
        if (act == 35) {
            return abi.encodeCall(Game.addController, (address(uint160(0x1000 + a[0]))));
        }
        if (act == 36) {
            return abi.encodeCall(Game.removeController, (address(uint160(0x1000 + a[0]))));
        }
        if (act == 18) return abi.encodeCall(Game.createFamily, (_name(a[0]), _name(a[1])));
        if (act == 19) return abi.encodeCall(Game.applyToFamily, (uint64(a[0])));
        if (act == 20) return abi.encodeCall(Game.withdrawApplication, (uint64(a[0])));
        if (act == 21) return abi.encodeCall(Game.answerApplication, (uint64(a[0]), a[1] == 1));
        if (act == 22) return abi.encodeCall(Game.leaveFamily, ());
        if (act == 23) return abi.encodeCall(Game.kickMember, (uint64(a[0])));
        if (act == 24) return abi.encodeCall(Game.setRank, (uint64(a[0]), uint8(a[1])));
        if (act == 25) return abi.encodeCall(Game.handOver, (uint64(a[0])));
        if (act == 26) return abi.encodeCall(Game.dissolveFamily, ());
        if (act == 27) return abi.encodeCall(Game.declareWar, (uint64(a[0])));
        if (act == 28) return abi.encodeCall(Game.offerPeace, (uint64(a[0]), uint8(a[1])));
        if (act == 29) return abi.encodeCall(Game.answerPeace, (uint64(a[0]), a[1] == 1));
        if (act == 30) {
            return
                abi.encodeCall(
                    Game.offerTrade, (uint64(a[0]), a[1], a[2], [a[3], a[4], a[5], a[6]])
                );
        }
        if (act == 31) return abi.encodeCall(Game.cancelTrade, (uint64(a[0])));
        return abi.encodeCall(Game.acceptTrade, (uint64(a[0])));
    }

    function _sendCall(uint256[] memory a) internal pure returns (bytes memory) {
        uint256[TROOPS] memory troops;
        uint256[RESOURCES] memory res;
        for (uint256 i; i < TROOPS; ++i) {
            troops[i] = a[5 + i];
        }
        for (uint256 r; r < RESOURCES; ++r) {
            res[r] = a[5 + TROOPS + r];
        }
        uint64 trade = a.length > 5 + TROOPS + RESOURCES ? uint64(a[5 + TROOPS + RESOURCES]) : 0;
        return abi.encodeCall(
            Game.sendMission, (uint64(a[0]), uint8(a[1]), [a[2], a[3], a[4]], troops, res, trade)
        );
    }

    function _errorName(bytes4 sel) internal pure returns (string memory) {
        string[46] memory names = [
            "AlreadyRegistered",
            "InvalidCoordinate",
            "SlotTaken",
            "NotRegistered",
            "NotOwner",
            "UnknownEntity",
            "RequirementsNotMet",
            "QueueFull",
            "CannotAfford",
            "TimingRoomRequired",
            "ResearchElsewhere",
            "NothingToCancel",
            "Backlog",
            "InvalidMission",
            "OwnTarget",
            "InvalidTroops",
            "NoUnits",
            "TooManyMissions",
            "CargoExceeded",
            "NotRecallable",
            "LastBuilding",
            "OnVacation",
            "Suspended",
            "TargetOnVacation",
            "VacationCooldown",
            "MissionsInFlight",
            "NotOnVacation",
            "ControllerTaken",
            "InvalidName",
            "NameTaken",
            "InFamily",
            "NotAllowed",
            "UnknownFamily",
            "TooManyApplications",
            "AlreadyApplied",
            "NoApplication",
            "AlreadyAtWar",
            "NoOffer",
            "InvalidOffer",
            "TooManyOffers",
            "InvalidTrade",
            "NotController",
            "InvalidSession",
            "SessionTooLong",
            "TooManyControllers",
            "LastController"
        ];
        for (uint256 i; i < names.length; ++i) {
            if (bytes4(keccak256(bytes(string.concat(names[i], "()")))) == sel) return names[i];
        }
        return "unknown revert";
    }

    function _matches(Game game, State memory exp) internal view returns (bool) {
        for (uint256 i; i < exp.buildings.length; ++i) {
            BuildingSnap memory e = exp.buildings[i];
            Game.BuildingView memory b = game.getBuilding(uint64(e.id));
            if (
                b.owner != e.owner || b.lastUpdate != e.lastUpdate || b.centipoints != e.centipoints
            ) {
                return false;
            }
            for (uint256 r; r < ROOMS; ++r) {
                if (b.levels[r] != e.levels[r]) return false;
            }
            for (uint256 r; r < RESOURCES; ++r) {
                if (b.stock[r] != e.stock[r]) return false;
            }
            if (!_sameQueue(b.roomQueue, e.queueIndex, e.queueSeq, e.queueFinish)) return false;
            for (uint256 t; t < TROOPS; ++t) {
                if (b.troops[t] != e.troops[t]) return false;
            }
            if (!_sameTraining(b.attackTraining, e.trainingAttack)) return false;
            if (!_sameTraining(b.defenseTraining, e.trainingDefense)) return false;
        }
        if (!_sameMissions(game, exp.missions) || !_noOtherBuildings(game, exp.buildings)) {
            return false;
        }
        for (uint256 i; i < exp.players.length; ++i) {
            PlayerSnap memory e = exp.players[i];
            Game.PlayerView memory p = game.getPlayer(uint64(e.id));
            if (
                p.buildings != e.buildings || p.centipoints != e.centipoints
                    || p.researchBuilding != e.researchBuilding || p.missions != e.missions
            ) return false;
            for (uint256 r; r < RESEARCH; ++r) {
                if (p.research[r] != e.research[r]) return false;
            }
            if (!_sameQueue(p.researchQueue, e.queueIndex, e.queueSeq, e.queueFinish)) {
                return false;
            }
            if (!_sameSocial(p, e) || !_sameControllers(p.controllers, e.controllers)) {
                return false;
            }
        }
        return _sameFamilies(game, exp.families) && _sameWars(game, exp.wars)
            && _sameTrades(game, exp.trades) && _sameSessions(game, exp.sessions);
    }

    function _sameControllers(address[] memory got, uint256[] memory exp)
        internal
        pure
        returns (bool)
    {
        if (got.length != exp.length) return false;
        for (uint256 i; i < got.length; ++i) {
            if (got[i] != address(uint160(0x1000 + exp[i]))) return false;
        }
        return true;
    }

    function _sameSessions(Game game, SessionSnap[] memory exp) internal view returns (bool) {
        for (uint256 i; i < exp.length; ++i) {
            Session memory k = game.getSession(address(uint160(0x1000 + exp[i].actor)));
            if (k.player != exp[i].player || k.until != exp[i].until || k.epoch != exp[i].epoch) {
                return false;
            }
        }
        return true;
    }

    function _sameSocial(Game.PlayerView memory p, PlayerSnap memory e)
        internal
        pure
        returns (bool)
    {
        uint256[6] memory f = [
            uint256(p.vacationUntil),
            p.suspendedUntil,
            p.premiumUntil,
            p.family,
            p.rank,
            p.sessionEpoch
        ];
        for (uint256 k; k < 6; ++k) {
            if (f[k] != e.social[k]) return false;
        }
        if (p.applications.length != e.applications.length || p.offers.length != e.offers.length) {
            return false;
        }
        for (uint256 i; i < p.applications.length; ++i) {
            if (p.applications[i] != e.applications[i]) return false;
        }
        for (uint256 i; i < p.offers.length; ++i) {
            if (p.offers[i] != e.offers[i]) return false;
        }
        return true;
    }

    function _sameFamilies(Game game, FamilySnap[] memory exp) internal view returns (bool) {
        (uint64 count,,) = game.socialCounters();
        if (count != exp.length) return false;
        for (uint256 i; i < exp.length; ++i) {
            Family memory f = game.getFamily(uint64(exp[i].id));
            if (
                f.alive != exp[i].alive || f.members != exp[i].members
                    || keccak256(bytes(f.tag)) != keccak256(bytes(exp[i].tag))
                    || keccak256(bytes(f.name)) != keccak256(bytes(exp[i].name))
            ) return false;
        }
        return true;
    }

    function _sameWars(Game game, WarSnap[] memory exp) internal view returns (bool) {
        (, uint64 count,) = game.socialCounters();
        if (count != exp.length) return false;
        for (uint256 i; i < exp.length; ++i) {
            War memory x = game.getWar(uint64(exp[i].id));
            uint256[8] memory f = [
                uint256(x.a), x.b, x.lostA, x.lostB, x.ended ? 1 : 0, x.winner, x.offer, x.offerBy
            ];
            for (uint256 k; k < 8; ++k) {
                if (f[k] != exp[i].fields[k]) return false;
            }
        }
        return true;
    }

    /// Cancelled trades are deleted in both implementations.
    function _sameTrades(Game game, TradeSnap[] memory exp) internal view returns (bool) {
        (,, uint64 last) = game.socialCounters();
        uint256 live;
        for (uint64 id = 1; id <= last; ++id) {
            if (game.getTrade(id).seller != 0) ++live;
        }
        if (live != exp.length) return false;
        for (uint256 i; i < exp.length; ++i) {
            Trade memory t = game.getTrade(uint64(exp[i].id));
            uint256[7] memory f = [
                uint256(t.seller),
                t.buyer,
                t.sold,
                t.accepted ? 1 : 0,
                t.acceptedAt,
                t.quantity,
                t.delivered
            ];
            for (uint256 k; k < 7; ++k) {
                if (f[k] != exp[i].fields[k]) return false;
            }
            for (uint256 r; r < RESOURCES; ++r) {
                if (t.price[r] != exp[i].price[r] || t.paid[r] != exp[i].paid[r]) return false;
            }
        }
        return true;
    }

    function _sameTraining(TrainingItem[] memory q, uint256[] memory flat)
        internal
        pure
        returns (bool)
    {
        if (q.length * 4 != flat.length) return false;
        for (uint256 i; i < q.length; ++i) {
            if (
                q[i].troop != flat[4 * i] || q[i].quantity != flat[4 * i + 1]
                    || q[i].seq != flat[4 * i + 2] || q[i].finishAt != flat[4 * i + 3]
            ) return false;
        }
        return true;
    }

    function _sameMissions(Game game, MissionSnap[] memory exp) internal view returns (bool) {
        (,,,, uint64 active,) = game.counters();
        if (active != exp.length || game.pendingMissions().length != exp.length) return false;
        for (uint256 i; i < exp.length; ++i) {
            MissionSnap memory e = exp[i];
            Mission memory m = game.getMission(uint64(e.id));
            uint256[11] memory f = [
                uint256(m.owner),
                m.origin,
                m.kind,
                m.returning ? 1 : 0,
                m.city,
                m.neighborhood,
                m.slot,
                m.start,
                m.arrival,
                m.duration,
                m.seq
            ];
            for (uint256 k; k < 11; ++k) {
                if (f[k] != e.fields[k]) return false;
            }
            for (uint256 t; t < TROOPS; ++t) {
                if (m.troops[t] != e.troops[t]) return false;
            }
            for (uint256 r; r < RESOURCES; ++r) {
                if (m.cargo[r] != e.cargo[r]) return false;
            }
        }
        return true;
    }

    /// Buildings not in the snapshot (abandoned) must be empty on-chain too.
    function _noOtherBuildings(Game game, BuildingSnap[] memory exp) internal view returns (bool) {
        (,, uint64 last,,,) = game.counters();
        for (uint64 id = 1; id <= last; ++id) {
            bool listed;
            for (uint256 i; i < exp.length; ++i) {
                if (exp[i].id == id) listed = true;
            }
            if (!listed && game.getBuilding(id).owner != 0) return false;
        }
        return true;
    }

    function _sameQueue(
        QueueItem[] memory q,
        uint256[] memory index,
        uint256[] memory seq,
        uint256[] memory finish
    ) internal pure returns (bool) {
        if (q.length != index.length) return false;
        for (uint256 i; i < q.length; ++i) {
            if (q[i].index != index[i] || q[i].seq != seq[i] || q[i].finishAt != finish[i]) {
                return false;
            }
        }
        return true;
    }

    function _compare(Game game, State memory exp, string memory where) internal view {
        for (uint256 i; i < exp.buildings.length; ++i) {
            BuildingSnap memory e = exp.buildings[i];
            Game.BuildingView memory b = game.getBuilding(uint64(e.id));
            string memory w = string.concat(where, " building ", vm.toString(e.id));
            assertEq(b.owner, e.owner, string.concat(w, " owner"));
            assertEq(b.lastUpdate, e.lastUpdate, string.concat(w, " lastUpdate"));
            assertEq(b.centipoints, e.centipoints, string.concat(w, " centipoints"));
            for (uint256 r; r < ROOMS; ++r) {
                assertEq(b.levels[r], e.levels[r], string.concat(w, " level"));
            }
            for (uint256 r; r < RESOURCES; ++r) {
                assertEq(b.stock[r], e.stock[r], string.concat(w, " stock"));
            }
            _compareQueue(
                b.roomQueue, e.queueIndex, e.queueSeq, e.queueFinish, string.concat(w, " queue")
            );
        }
        for (uint256 i; i < exp.players.length; ++i) {
            PlayerSnap memory e = exp.players[i];
            Game.PlayerView memory p = game.getPlayer(uint64(e.id));
            string memory w = string.concat(where, " player ", vm.toString(e.id));
            assertEq(p.buildings, e.buildings, string.concat(w, " buildings"));
            assertEq(p.centipoints, e.centipoints, string.concat(w, " centipoints"));
            assertEq(p.researchBuilding, e.researchBuilding, string.concat(w, " researchBuilding"));
            assertEq(p.controllers.length, e.controllers.length, string.concat(w, " controllers"));
            for (uint256 c; c < e.controllers.length; ++c) {
                assertEq(
                    p.controllers[c],
                    address(uint160(0x1000 + e.controllers[c])),
                    string.concat(w, " controller")
                );
            }
            for (uint256 r; r < RESEARCH; ++r) {
                assertEq(p.research[r], e.research[r], string.concat(w, " research"));
            }
            _compareQueue(
                p.researchQueue, e.queueIndex, e.queueSeq, e.queueFinish, string.concat(w, " queue")
            );
        }
    }

    function _compareQueue(
        QueueItem[] memory q,
        uint256[] memory index,
        uint256[] memory seq,
        uint256[] memory finish,
        string memory w
    ) internal pure {
        assertEq(q.length, index.length, string.concat(w, " length"));
        for (uint256 i; i < q.length; ++i) {
            assertEq(q[i].index, index[i], w);
            assertEq(q[i].seq, seq[i], w);
            assertEq(q[i].finishAt, finish[i], w);
        }
    }
}
