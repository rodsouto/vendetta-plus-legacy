pragma solidity 0.8.28;

import {Vm} from "forge-std/Vm.sol";
import {TROOPS, RESEARCH} from "../../src/generated/VendettaRuleset.sol";

/// Loads the fixtures generated by packages/spec-data (pnpm codegen). Struct fields are declared in
/// the alphabetical order of the JSON keys: forge's parseJson decodes objects by sorted key.
library Fixtures {
    Vm private constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
    string private constant DIR = "../packages/spec-data/generated/fixtures/vendetta/";

    struct CombatCase {
        uint256[] attacker;
        uint256[][] attackerDeaths;
        uint256[] attackerRemaining;
        uint256[] defender;
        uint256[][] defenderDeaths;
        uint256[] defenderRemaining;
        string label;
        uint256 pctA;
        uint256 pctD;
        uint256 researchA;
        uint256 researchD;
        uint256 rounds;
    }

    struct TroopStatsCase {
        uint256 attack;
        uint256 capacity;
        uint256 defense;
        uint256 level;
        uint256 speed;
        uint256 troop;
        bool withMobility;
    }

    struct LootCase {
        uint256 capacity;
        string label;
        uint256[] loot;
        uint256[] unprotected;
    }

    struct HonorCase {
        uint256 buildings;
        uint256 honor;
        uint256 pct;
    }

    function combat() internal view returns (CombatCase[] memory) {
        return abi.decode(_cases("combat.json"), (CombatCase[]));
    }

    function troopStats() internal view returns (TroopStatsCase[] memory) {
        return abi.decode(_cases("troop_stats.json"), (TroopStatsCase[]));
    }

    function loot() internal view returns (LootCase[] memory) {
        return abi.decode(_cases("loot.json"), (LootCase[]));
    }

    function honor() internal view returns (HonorCase[] memory) {
        return abi.decode(_cases("honor.json"), (HonorCase[]));
    }

    function troops(uint256[] memory a) internal pure returns (uint256[TROOPS] memory out) {
        require(a.length == TROOPS, "fixture: troop array length");
        for (uint256 i; i < TROOPS; ++i) {
            out[i] = a[i];
        }
    }

    function allResearch(uint256 level) internal pure returns (uint256[RESEARCH] memory out) {
        for (uint256 i; i < RESEARCH; ++i) {
            out[i] = level;
        }
    }

    function _cases(string memory file) private view returns (bytes memory) {
        return vm.parseJson(vm.readFile(string.concat(DIR, file)), ".cases");
    }
}
