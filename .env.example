# Copy to .env (git-ignored) and fill in. Used by scripts/deploy-gnosis.sh and by the web build
# for Gnosis Chain (pnpm build:gnosis). See docs/deploy-gnosis.md.

# --- Contracts deploy (never reaches the browser) ---
# Key of the deployer: a fresh account used only for this, funded with xDAI on Gnosis (chain 100).
DEPLOYER_PRIVATE_KEY=
# Owner of the Game (upgrades, suspensions, premium). A Safe in production (B-17); empty = deployer.
ADMIN=
# RPC used to deploy; empty = the public https://rpc.gnosischain.com.
GNOSIS_RPC_URL=

# --- Web app (VITE_* end up in the public bundle) ---
# Pimlico API key: bundler and paymaster. Restrict it by origin in the Pimlico dashboard.
VITE_PIMLICO_API_KEY=
# Sponsorship policy id (sp_...) that caps the spending (B-16).
VITE_PIMLICO_POLICY_ID=
# ERC-4337 EntryPoint 0.7 bundler with PRIVATE executor submission for reveals (B-22).
# A raw Shutter RPC cannot serve as a bundler. See docs/deploy-gnosis.md before configuring this.
VITE_REVEAL_BUNDLER_URL=
# RPC for reads; empty = the one in deployments/gnosis.json (public RPC).
VITE_RPC_URL=
# GraphQL endpoint of the subgraph (vendetta/prod, `goldsky subgraph list`) for the battle reports;
# empty = read them from the RPC logs, only the last two weeks.
VITE_INDEXER_URL=

# --- Keeper (server only) ---
# Funded xDAI account. Never VITE_*.
KEEPER_PRIVATE_KEY=
# Private/encrypted raw-transaction RPC for reveals; must never fall back to the public mempool.
REVEAL_RPC_URL=
