# Copy to .env (git-ignored) and fill in. Used by scripts/deploy-arbitrum.sh and by the web build
# for Arbitrum One (pnpm build:arbitrum). See docs/deploy-arbitrum.md.

# --- Contracts deploy (never reaches the browser) ---
# Key of the deployer: a fresh account used only for this, funded with ~0.005 ETH on Arbitrum One.
DEPLOYER_PRIVATE_KEY=
# Owner of the Game (upgrades, suspensions, premium). A Safe in production (B-17); empty = deployer.
ADMIN=
# RPC used to deploy; empty = the public https://arb1.arbitrum.io/rpc.
ARBITRUM_RPC_URL=
# Etherscan API key (v2, works for Arbiscan) to verify the contracts; empty = skip verification.
ETHERSCAN_API_KEY=

# --- Web app (VITE_* end up in the public bundle) ---
# Pimlico API key: bundler and paymaster. Restrict it by origin in the Pimlico dashboard.
VITE_PIMLICO_API_KEY=
# Sponsorship policy id (sp_...) that caps the spending (B-16).
VITE_PIMLICO_POLICY_ID=
# RPC for reads; empty = the one in deployments/arbitrum.json (public RPC).
VITE_RPC_URL=
# GraphQL endpoint of the subgraph on Goldsky (vendetta/prod); empty = no ranking.
VITE_INDEXER_URL=
