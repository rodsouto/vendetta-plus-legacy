# Copy to .env (git-ignored) and fill in. Used by scripts/deploy-gnosis.sh and by the web build
# for Gnosis Chain (pnpm build:gnosis). See docs/deploy-gnosis.md.

# --- Contracts deploy (never reaches the browser) ---
# Key of the deployer: a fresh account used only for this, funded with xDAI on Gnosis (chain 100).
DEPLOYER_PRIVATE_KEY=
# Roles of the Game (B-17). ADMIN upgrades and assigns roles: a Safe in production; empty = deployer.
ADMIN=
# OPERATOR grants premium (B-25), ARBITER suspends players (B-14); empty = ADMIN.
OPERATOR=
ARBITER=
# Mandatory v2 consumers already deployed and reviewed for this chain/profile.
HIDDEN_OPENING_CONSUMER=
HIDDEN_INVALID_POINT_CONSUMER=
# RPC used to deploy; empty = the public https://rpc.gnosischain.com.
GNOSIS_RPC_URL=

# --- Web app (VITE_* end up in the public bundle) ---
# Pimlico API key: bundler and paymaster. Restrict it by origin in the Pimlico dashboard.
VITE_PIMLICO_API_KEY=
# Sponsorship policy id (sp_...) that caps the spending (B-16).
VITE_PIMLICO_POLICY_ID=
# RPC for reads; empty = the one in deployments/gnosis.json (public RPC).
VITE_RPC_URL=
# GraphQL endpoint of the subgraph (vendetta/prod, `goldsky subgraph list`) for the battle reports;
# empty = read them from the RPC logs, only the last two weeks.
VITE_INDEXER_URL=

# --- Keeper (server only) ---
# Exclusive persistent journal directory; default: $XDG_STATE_HOME/vendetta/keeper
# or ~/.local/state/vendetta/keeper. Keep it outside the web/static serving roots.
# Keep it across restarts. Use a dedicated keeper signer and one process per directory.
KEEPER_STATE_DIR=
# Funded xDAI account dedicated to one keeper. Never VITE_*.
KEEPER_PRIVATE_KEY=
# Certificate service endpoint. Must return an ABI-encoded certificate after preparing H3 state.
# Operational failures are retried; no timeout or decrypt-error cancellation exists.
HIDDEN_PROVER_URL=
# Bearer token assigned to this keeper in the producer clients file. Never VITE_*.
HIDDEN_PROVER_TOKEN=

# --- Certificate producer (server only; no VITE_* secrets) ---
# Build current Go sources from apps/web/scripts/experiments/opening-zk; keep the binary outside Git.
# Requires --prove-worker-v2 with per-job IDs; proving keeps one setup resident.
HIDDEN_PROVER_BIN=
# Required private JSON clients file (tokens, scopes and quotas), outside Git.
HIDDEN_PROVER_CLIENTS_FILE=
# Parent directory containing opening/ and invalid-point/ setups.
HIDDEN_PROVER_KEYS=
# Private persistent proof cache directory, outside the repository.
HIDDEN_PROVER_CACHE=
# Funded account for H3 preparation transactions. Never reaches the browser.
HIDDEN_H3_PRIVATE_KEY=
# Loopback HTTP port; keeper endpoint is http://127.0.0.1:8787/ by default.
HIDDEN_PROVER_PORT=8787
# Deadline per native inspection or worker proof job; SIGKILL and wait for exit before retry.
HIDDEN_PROVER_TIMEOUT_MS=900000
# Optional producer RPC override; otherwise use deployment.json's RPC.
RPC_URL=
PROVER_THREADS=8
PROVER_MEMORY=6GiB
# Explicit opt-in for unsafe research keys, accepted ONLY on chain IDs 1337/31337.
# Never enable for a real deployment; secure setup and security review remain required.
ALLOW_UNSAFE_LOCAL_SETUP=0
# Optional compiler overrides for pnpm --filter @vendetta/web prover:compile <keys-directory> <fresh-output-directory>.
FORGE_BIN=forge
SOLC_BIN=
# Proof cache budgets enforced at startup and between serialized jobs.
HIDDEN_PROVER_CACHE_MAX_BYTES=67108864
HIDDEN_PROVER_CACHE_MAX_FILES=4096
HIDDEN_PROVER_CACHE_MAX_AGE_MS=604800000

# Runtime metadata produced in a fresh directory by prover:compile <keys> <output>.
# Empty preserves the legacy <keys>/verifier-runtime.json read path.
HIDDEN_PROVER_RUNTIME=
# Producer and keeper state leases require Linux util-linux flock; never delete
# .vendetta-state.lock. Use a dedicated local directory and signer per instance.
