    uint256 constant DELTA_NEG_X_1 = 20119191209521211630102051543366203324293184654130936776499407702592047514743;
    uint256 constant DELTA_NEG_Y_0 = 9036838540548586807258851627371333747585373172611687944021369792401903024561;
    uint256 constant DELTA_NEG_Y_1 = 236076713778644856074637016297550976476399545649288378914924564692681256578;
