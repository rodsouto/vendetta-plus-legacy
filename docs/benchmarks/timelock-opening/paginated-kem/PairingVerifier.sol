    uint256 constant PEDERSEN_G_X_1 = 3539100404517687737782114107727885173140855185033472944065172628197713359742;
    uint256 constant PEDERSEN_G_Y_0 = 15907089551921537306805160333058478117028535407691191731278858117858285339366;
    uint256 constant PEDERSEN_G_Y_1 = 15540703324173940996160876320464966112604152700614033142176623881212177663932;

    // Pedersen GSigmaNeg point in G2 in powers of i
    uint256 constant PEDERSEN_GSIGMANEG_X_0 = 16388468211530359290897000761929134510987448381157905888672344517740103522588;
    uint256 constant PEDERSEN_GSIGMANEG_X_1 = 16130399206480318532450034944060204342834828244820832423666954447798805435470;
    uint256 constant PEDERSEN_GSIGMANEG_Y_0 = 10157643867029056514694954535462154441246165203066227899651791527047912917494;
    uint256 constant PEDERSEN_GSIGMANEG_Y_1 = 12035070791142181938124525822785625715584523641000257408380257125183243302866;

    // Constant and public input points
    uint256 constant CONSTANT_X = 21653291291844577722275616052199406964888509667533362790780508280288895171823;
    uint256 constant CONSTANT_Y = 20064417199786817363741687809429726573389500638947317459345901206701062116718;
    uint256 constant PUB_0_X = 16799117685631969308511788612135827045119191884423635810515445487776633643233;
