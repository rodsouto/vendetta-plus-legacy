    uint256 constant GAMMA_NEG_X_1 = 15336389812679696740989187189286485301972300126810307943948337776013934880797;
    uint256 constant GAMMA_NEG_Y_0 = 20312152886068454387783897035879646286665771220329995569431283328855307927735;
    uint256 constant GAMMA_NEG_Y_1 = 6238541327564338212257163759828955258032516344845518785727073534346712821770;

